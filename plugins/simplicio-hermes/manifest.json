{
  "name": "simplicio-hermes",
  "version": "0.3.0",
  "host": "hermes",
  "entry": "./index.mjs",
  "hooks": [
    "on_session_start",
    "llm_request",
    "llm_execution",
    "post_api_request",
    "api_request_error"
  ],
  "modes": [
    "mapper-only"
  ],
  "runtime": {
    "prepare": "prepare_model_call",
    "record": "record_model_result",
    "mode": "mapper-only",
    "login_required": true
  },
  "failure_policy": "best_effort"
}
