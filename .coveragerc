[run]
branch = True
source = scripts
omit =
    scripts/run_python_tests.py
    # These are exercised by dedicated integration/e2e jobs. The unit coverage
    # gate measures modules whose behavior is owned by the Python unit suite.
    scripts/codex_integration.py
    scripts/e2e_clean_install.py
    scripts/e2e_ecosystem.py
    scripts/post_release_smoke.py
    scripts/release_install_smoke.py

[report]
show_missing = True
skip_covered = False
exclude_also =
    if __name__ == .__main__.:

[xml]
output = artifacts/unit/python-coverage.xml

[json]
output = artifacts/unit/python-coverage.json
